
# No default on purpose (D3): an address with a default means a
# misconfigured merchant silently pays someone else.
MERCHANT_PAY_TO=

# Agent retries after a resignable refusal. 0 disables retry entirely.
AGENT_MAX_RETRIES=1

# Key sources. Files are the demo path; the inline seeds are what a
# deployment injects. Neither has a create-if-missing branch.
# FEE_PAYER_SEED=
# AGENT_SEED=
# FEE_PAYER_KEY_FILE=.keys/fee-payer.json
# AGENT_KEY_FILE=.keys/agent.json
